{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/admin/Dockerfile",
    "watchPatterns": ["apps/admin/**", "packages/shared/**", "deploy/**", "package-lock.json"]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE"
  }
}
