# PostgreSQL ulanishi
DATABASE_URL=postgres://localhost:5432/muslima_cosmetics

PORT=8080
HOST=0.0.0.0

# JWT imzosi uchun kamida 32 belgili tasodifiy satr: `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Sayt va admin panel domenlari (vergul bilan). Dev'da Vite proxy ishlatiladi, shuning uchun shart emas.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Kunlik statistika shu vaqt mintaqasida hisoblanadi
SHOP_TZ=Asia/Tashkent

# Birinchi admin (db:seed shu ma'lumotlar bilan yaratadi / parolini yangilaydi)
ADMIN_EMAIL=admin@muslima.uz
ADMIN_PASSWORD=admin123
ADMIN_NAME=Muslima

# Yangi buyurtma haqida Telegram xabari (ixtiyoriy).
# Bot: @BotFather → token. Chat ID: botga yozing va https://api.telegram.org/bot<TOKEN>/getUpdates dan oling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
